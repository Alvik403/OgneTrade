# Demo logins (created by seed on first run):
# Admin:   admin@example.ru / admin12345
# Manager: manager@example.ru / manager12345

# Application
APP_NAME=Огнетушители
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true 
ENVIRONMENT=development

# Database (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./lids.db
# DATABASE_URL=postgresql://lids:lids@db:5432/lids

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
IP_HASH_SALT=change-me-ip-salt
CSRF_SECRET=change-me-csrf-secret
ADMIN_PATH_PREFIX=/admin

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cookie security (set Secure=true in production with HTTPS)
COOKIE_SECURE=false

# Public site URL (used in privacy policy and notifications)
SITE_URL=https://ognetrade.online
ALLOWED_HOSTS=ognetrade.online,ognetrade.ru,www.ognetrade.ru,localhost,127.0.0.1
ENVIRONMENT=development
