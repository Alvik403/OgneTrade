# Production environment for ognetrade.online
# Copy to .env on the server: cp .env.production.example .env

APP_NAME=OgneTrade
ENVIRONMENT=production
DEBUG=false
SITE_URL=https://ognetrade.online
# localhost/127.0.0.1 — для Docker healthcheck внутри контейнера
ALLOWED_HOSTS=ognetrade.ru,www.ognetrade.ru,localhost,127.0.0.1

# Generate strong secrets, e.g. openssl rand -hex 32
SECRET_KEY=replace-with-64-char-random-string
IP_HASH_SALT=replace-with-random-salt
CSRF_SECRET=replace-with-random-csrf-secret

# Use letters and digits only — special chars break DATABASE_URL in Docker Compose.
POSTGRES_USER=lids
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=lids

COOKIE_SECURE=true
ADMIN_PATH_PREFIX=/admin

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
